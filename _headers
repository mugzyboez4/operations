# Allow embedding from any origin (Airtable, SharePoint, etc.)
# Note: frame-ancestors MUST be set via HTTP header (meta tag is ignored by browsers)

/smt/*
  Content-Security-Policy: frame-ancestors *
  Permissions-Policy: clipboard-write=*, fullscreen=*

/smt
  Content-Security-Policy: frame-ancestors *

/smt/
  Content-Security-Policy: frame-ancestors *

/artists/*
  Content-Security-Policy: frame-ancestors *

/pitchdecks/*
  Content-Security-Policy: frame-ancestors *

/pitchdecks
  Content-Security-Policy: frame-ancestors *

/pitchdecks/
  Content-Security-Policy: frame-ancestors *

# Hub: allow all site pages to load inside the /hub/ shell iframe + SharePoint
/*
  Content-Security-Policy: frame-ancestors *

/pilot/*
  Content-Security-Policy: frame-ancestors *

/pilot
  Content-Security-Policy: frame-ancestors *

# Office Resource Guide: embeddable in SharePoint
/office-guide/*
  Content-Security-Policy: frame-ancestors *

/office-guide
  Content-Security-Policy: frame-ancestors *

# Stylesheet served to the WordPress site — allow it cross-origin
/tempo-wordpress.css
  Access-Control-Allow-Origin: *
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=300

/tempo.css
  Access-Control-Allow-Origin: *

# Rebuilt WordPress page sources — fetched cross-origin from wp-admin.
# text/plain so the HTML sources come back as text; the stylesheet needs its
# real type or the browser refuses to apply it.
/wp/*
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store

/wp/retrofit.css
  Access-Control-Allow-Origin: *
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=300

# Digital Partner Guide — the page and its script are fetched cross-origin by
# the Campaign Ops WordPress copy, and the feed is read by both.
/partner-guide.html
  Content-Security-Policy: frame-ancestors *
  Cache-Control: public, max-age=60

/partner-guide.js
  Access-Control-Allow-Origin: *
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=60

/api/partner-guide
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=60
