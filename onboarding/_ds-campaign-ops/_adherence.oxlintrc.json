{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/campaign-ops/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Suisse Intl|ITC Compacta|Bodoni Moda|DM Mono|Pinyon Script|Style Script))/i]",
        "message": "Font not provided by the design system. Available: Suisse Intl, ITC Compacta, Bodoni Moda, DM Mono, Pinyon Script, Style Script."
      },
      {
        "selector": "JSXOpeningElement[name.name='Nav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNav|key|ref|className|style|children)$/]",
        "message": "<Nav> doesn't accept that prop. Declared props: active, onNav."
      },
      {
        "selector": "JSXOpeningElement[name.name='LizzyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:cleared|key|ref|className|style|children)$/]",
        "message": "<LizzyBar> doesn't accept that prop. Declared props: cleared."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Nav": {
        "replaces": []
      },
      "LizzyBar": {
        "replaces": []
      }
    },
    "tokens": [
      "--bg",
      "--border",
      "--card",
      "--card-2",
      "--clear",
